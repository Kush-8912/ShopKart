# Copy this file to .env and fill in your own values. Never commit .env.

# MongoDB connection string (MongoDB Atlas -> Connect -> Drivers)
dbUrl=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ShopKart

# Any long random string, used to sign login tokens
jwt_secret=<any-long-random-string>

# Razorpay TEST MODE keys (Dashboard -> Test Mode -> Account & Settings -> API Keys)
# The secret stays on the backend only. Never put it in the frontend or commit it.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=<your-razorpay-test-key-secret>

# Optional
# PORT=8085
# CLIENT_URL=https://your-frontend.vercel.app   (only needed if the frontend calls the API cross-origin)
# NODE_ENV=production                           (enables secure cookies and disables dev-only routes)
